; Copy to @extDB3/sql_custom/bn_koth.ini on the dedicated server.
; This file contains prepared statements only and no credentials.

[Default]
Version = 1
Strip Chars = "':;[]{}()<>/\\|
Strip Chars Mode = 2
Input SQF Parser = false
Number of Retrys = 1

[loadPlayer]
Prepared Statement = true
SQL1_1 = SELECT uid, schema_version, xp, cash, owned_weapons, weapon_kills
SQL1_2 = FROM bn_koth_player_progression WHERE uid = ? LIMIT 2;
SQL1_INPUTS = 1
OUTPUT = 1-STRING,2,3,4,5-STRING,6-STRING

[savePlayer]
Prepared Statement = true
SQL1_1 = INSERT INTO bn_koth_player_progression
SQL1_2 = (uid, schema_version, xp, cash, owned_weapons, weapon_kills)
SQL1_3 = VALUES (?, ?, ?, ?, ?, ?)
SQL1_4 = ON DUPLICATE KEY UPDATE schema_version = VALUES(schema_version),
SQL1_5 = xp = VALUES(xp), cash = VALUES(cash), owned_weapons = VALUES(owned_weapons),
SQL1_6 = weapon_kills = VALUES(weapon_kills), updated_at = CURRENT_TIMESTAMP;
SQL1_INPUTS = 1,2,3,4,5,6
Return InsertID = false
